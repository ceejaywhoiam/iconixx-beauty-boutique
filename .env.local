# Stripe secret key — server-side only, never expose real credentials in git.
STRIPE_SECRET_KEY=sk_test_mock_replace_me

# Stripe publishable key — safe to expose to the browser (VITE_ prefix).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_mock_replace_me

# Supabase APIs and URLs (mock defaults for local setup)
SUPABASE_URL=https://example.supabase.co
VITE_SUPABASE_URL=https://example.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_mock_replace_me
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mock_replace_me
SUPABASE_SERVICE_ROLE_KEY=sb_secret_mock_replace_me