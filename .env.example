# Stripe — server-side only (never expose to the browser)
STRIPE_SECRET_KEY=sk_test_...

# Stripe — safe to expose to the browser
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe webhook signing secret — obtained from Stripe Dashboard or Stripe CLI
# For local testing with Stripe CLI:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# The CLI will print a webhook signing secret starting with "whsec_".
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase (optional — used for persistence / auth)
SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJ...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
